# Route all SSH auth through the 1Password SSH agent.
# On WSL2 this socket doesn't exist by itself -- 1Password's agent lives on
# the Windows host, so something needs to bridge the Windows named pipe to
# this unix socket path (1Password's documented approach uses npiperelay.exe
# + socat, started from your shell rc). Until that bridge is running, SSH
# will fall back to the IdentityFile entries below.
Host *
    IdentityAgent ~/.1password/agent.sock
    ServerAliveInterval 60
    ServerAliveCountMax 3
    EnableEscapeCommandline
    ForwardAgent yes
    ForwardX11 yes
    


